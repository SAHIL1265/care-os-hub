# ==============================================================================
# Environment Variables Configuration Template (.env.example)
# Copy this file to .env and replace placeholder values with actual credentials.
# DO NOT commit your actual .env file to public version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration (Backend / Server-side)
# ------------------------------------------------------------------------------
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""

# ------------------------------------------------------------------------------
# Supabase Configuration (Frontend / Vite)
# Accessible in client code via import.meta.env.VITE_*
# ------------------------------------------------------------------------------
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# ------------------------------------------------------------------------------
# Google Gemini API Keys
# ------------------------------------------------------------------------------
# Server-side Gemini API key (Recommended for Node.js / API route proxies)
GEMINI_API_KEY=""

# Client-side Gemini API key (Vite frontend)
VITE_GEMINI_API_KEY=""
